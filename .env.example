# ---------------------------------------------------------------------------
# Pilk website environment variables
# Copy this file to `.env.local` and fill in real values for your environment.
# Never commit `.env.local` or real secrets to version control.
# ---------------------------------------------------------------------------

# Public site URL, used for canonical links, sitemap, and Open Graph metadata.
# Example: https://pilk.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Waitlist persistence
# ---------------------------------------------------------------------------
# Optional. When set, waitlist submissions are written to a Postgres database
# (works with Supabase, Neon, RDS, etc.). Requires the `pg` package to be
# installed: `npm install pg`.
#
# When DATABASE_URL is empty, the site falls back to a local JSON file store
# under `.data/waitlist.json` so development works with zero setup.
#
# Example: postgres://user:password@host:5432/dbname
DATABASE_URL=

# ---------------------------------------------------------------------------
# Analytics (optional, privacy-conscious)
# ---------------------------------------------------------------------------
# If you add a privacy-friendly analytics provider (e.g. Plausible, Fathom),
# configure it here. Left blank, no analytics scripts are loaded.
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=
