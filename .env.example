# ---------------------------------------------------------------------------
# Pilk website environment variables
# Copy this file to `.env.local` for local development. In CI (GitHub Actions),
# these are set by the deploy workflow / repo variables — see README.
# Never commit `.env.local` or real secrets.
# ---------------------------------------------------------------------------

# Deployment ORIGIN (scheme + host, no path). Used for absolute URLs in
# metadata, sitemap, robots, and the Open Graph image.
#   Production (custom domain):  https://gotpilk.com
#   GitHub Pages project site:   https://<your-username>.github.io
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base path the site is served under. Empty ("") for the custom domain
# (gotpilk.com) or a user page; the repo name ("/pilk-site") for a project page.
# Must match `basePath` in next.config.mjs (which reads this same variable).
# The deploy workflow sets this automatically (empty when public/CNAME exists).
NEXT_PUBLIC_BASE_PATH=

# ---------------------------------------------------------------------------
# Waitlist (static hosting has no server, so the form posts to an external
# service). Set a Formspree form id to enable real submissions:
#   1. Create a free form at https://formspree.io
#   2. Put its id here (the part after /f/ in your form's endpoint).
# If left blank, the waitlist form falls back to a pre-filled email to your
# support address so it is never broken.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FORMSPREE_ID=

# Brand domain used for contact emails (e.g. hello@gotpilk.com). Independent of
# the hosting URL. Defaults to gotpilk.com.
NEXT_PUBLIC_BRAND_DOMAIN=gotpilk.com

# ---------------------------------------------------------------------------
# Analytics (optional, privacy-conscious). Left blank, no analytics load.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SRC=
